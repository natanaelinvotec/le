{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/capoeira/**",
              "components/core/**",
              "components/feedback/**",
              "components/navigation/**",
              "ui_kits/inscricao/**",
              "ui_kits/painel-admin/**",
              "ui_kits/portal-aluno/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Great Vibes|Montserrat|Nunito))/i]",
        "message": "Font not provided by the design system. Available: Great Vibes, Montserrat, Nunito."
      },
      {
        "selector": "JSXOpeningElement[name.name='AcademyCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|teacher|login|index|onEdit|onDelete|key|ref|className|style|children)$/]",
        "message": "<AcademyCard> doesn't accept that prop. Declared props: name, teacher, login, index, onEdit, onDelete."
      },
      {
        "selector": "JSXOpeningElement[name.name='Alert'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|key|ref|className|style|children)$/]",
        "message": "<Alert> doesn't accept that prop. Declared props: icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|blue|green|warn|danger)$/]",
        "message": "<Badge> tone must be one of 'teal' | 'blue' | 'green' | 'warn' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|shape|icon|iconRight|block|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, shape, icon, iconRight, block."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|blue|confirm|buy|neutral|danger|danger-outline|warn|slate)$/]",
        "message": "<Button> variant must be one of 'primary' | 'blue' | 'confirm' | 'buy' | 'neutral' | 'danger' | 'danger-outline' | 'warn' | 'slate'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:default|pill|round)$/]",
        "message": "<Button> shape must be one of 'default' | 'pill' | 'round'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|hover|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, hover."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|shadow|panel)$/]",
        "message": "<Card> variant must be one of 'default' | 'shadow' | 'panel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChartBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|height|fullWidth|children|key|ref|className|style|children)$/]",
        "message": "<ChartBox> doesn't accept that prop. Declared props: title, height, fullWidth, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='CordaoBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:percent|colors|size|key|ref|className|style|children)$/]",
        "message": "<CordaoBar> doesn't accept that prop. Declared props: percent, colors, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='CordaoBar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|lg)$/]",
        "message": "<CordaoBar> size must be one of 'sm' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CriterionPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|score|max|style|key|ref|className|style|children)$/]",
        "message": "<CriterionPill> doesn't accept that prop. Declared props: name, score, max, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|children|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|icon|label|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: variant, icon, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:danger|ghost)$/]",
        "message": "<IconButton> variant must be one of 'danger' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|icon|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, size, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Input> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LessonCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:embedUrl|thumbnail|title|description|href|key|ref|className|style|children)$/]",
        "message": "<LessonCard> doesn't accept that prop. Declared props: embedUrl, thumbnail, title, description, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|size|onClose|children|key|ref|className|style|children)$/]",
        "message": "<Modal> doesn't accept that prop. Declared props: open, size, onClose, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Modal'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Modal> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|active|icon|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: variant, active, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:pill|underline)$/]",
        "message": "<NavItem> variant must be one of 'pill' | 'underline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProductCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:image|name|description|price|onBuy|key|ref|className|style|children)$/]",
        "message": "<ProductCard> doesn't accept that prop. Declared props: image, name, description, price, onBuy."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProfileBanner'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|name|academy|cordao|key|ref|className|style|children)$/]",
        "message": "<ProfileBanner> doesn't accept that prop. Declared props: photo, name, academy, cordao."
      },
      {
        "selector": "JSXOpeningElement[name.name='RuleBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|warning|children|key|ref|className|style|children)$/]",
        "message": "<RuleBox> doesn't accept that prop. Declared props: title, warning, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|children|key|ref|className|style|children)$/]",
        "message": "<SectionHeader> doesn't accept that prop. Declared props: tone, icon, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeader'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|blue)$/]",
        "message": "<SectionHeader> tone must be one of 'teal' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|size|options|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, size, options."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Select> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StarRating'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|onChange|key|ref|className|style|children)$/]",
        "message": "<StarRating> doesn't accept that prop. Declared props: value, max, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepIndicator'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|key|ref|className|style|children)$/]",
        "message": "<StepIndicator> doesn't accept that prop. Declared props: steps, current."
      },
      {
        "selector": "JSXOpeningElement[name.name='StudentCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|name|academy|cordao|age|index|academies|onDetails|key|ref|className|style|children)$/]",
        "message": "<StudentCard> doesn't accept that prop. Declared props: photo, name, academy, cordao, age, index, academies, onDetails."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeacherBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:photo|name|title|bio|key|ref|className|style|children)$/]",
        "message": "<TeacherBox> doesn't accept that prop. Declared props: photo, name, title, bio."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tone, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:info|success|error)$/]",
        "message": "<Toast> tone must be one of 'info' | 'success' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TopNav'] > JSXAttribute > JSXIdentifier[name!=/^(?:logoSrc|title|children|right|style|key|ref|className|style|children)$/]",
        "message": "<TopNav> doesn't accept that prop. Declared props: logoSrc, title, children, right, style."
      }
    ]
  },
