rules_version = '2';
// Projeto antigo (capoeira-liberdade) depois da migração para atletapay-br: ninguém lê nem grava.
// Quem ainda abrir uma versão antiga do app cai aqui, sem conseguir alterar nada.
service cloud.firestore { match /databases/{database}/documents { match /{document=**} { allow read, write: if false; } } }
