rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function meuPerfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function ehAdmin() { return logado() && meuPerfil().papel == 'admin'; }
    function ehGestor() { return logado() && (meuPerfil().papel == 'admin' || meuPerfil().papel == 'mestre'); }

    // Cada um lê o próprio cadastro; só o Master Admin muda papel e academia
    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || ehGestor());
      allow update: if request.auth.uid == uid || ehAdmin();
      allow create, delete: if ehAdmin();
    }

    // Aluno lê o próprio prontuário; responsável lê os dos filhos vinculados
    match /alunos/{alunoId} {
      allow read: if logado() && (
        request.auth.uid == alunoId ||
        ehGestor() ||
        request.auth.uid in resource.data.responsaveis
      );
      allow write: if ehGestor();

      match /avaliacoes/{aval} {
        allow read: if logado() && (request.auth.uid == alunoId || ehGestor());
        allow write: if ehGestor();
      }
    }

    // Material de estudo: todo aluno lê, só gestor publica
    match /materiais/{id} {
      allow read: if logado();
      allow write: if ehGestor();
    }

    // Financeiro: aluno vê o que é dele, gestor lança
    match /pagamentos/{id} {
      allow read: if logado() && (resource.data.alunoId == request.auth.uid || ehGestor());
      allow write: if ehGestor();
    }

    match /academias/{id} {
      allow read: if logado();
      allow write: if ehAdmin();
    }
  }
}
