rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

function logado() { return request.auth != null; }
function meuPerfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
function meusPapeis() { return meuPerfil().papeis; }
function ehAdmin() { return logado() && 'admin' in meusPapeis(); }
function ehGestor() { return logado() && meusPapeis().hasAny(['admin', 'mestre']); }
function ehInstrutor() { return logado() && 'instrutor' in meusPapeis(); }
function souFundador() { return logado() && meuPerfil().acessoGeral == true; }
function minhaAcademiaGerenciada() { return meuPerfil().academiaGerenciadaId; }
function papeisInalterados() { return request.resource.data.papeis == resource.data.papeis; }
function academiaInalterada() { return request.resource.data.academiaId == resource.data.academiaId; }
function academiaGerenciadaInalterada() { return request.resource.data.academiaGerenciadaId == resource.data.academiaGerenciadaId; }
function notasInalteradas() { return request.resource.data.notas == resource.data.notas; }
function acessoGeralInalterado() { return request.resource.data.acessoGeral == resource.data.acessoGeral; }
function souInstrutorDoAluno() { return ehInstrutor() && resource.data.instrutorUid == request.auth.uid; }

match /usuarios/{uid} {
allow read: if logado() && (
request.auth.uid == uid ||
ehAdmin() ||
souFundador() ||
(ehGestor() && resource.data.academiaId == minhaAcademiaGerenciada()) ||
(ehInstrutor() && resource.data.instrutorUid == request.auth.uid) ||
resource.data.responsavelUid == request.auth.uid
);

allow create: if ehAdmin() ||
(request.auth.uid == uid && request.resource.data.papeis == ['aluno']);

// souFundador() aditivo, sem restrição de campo: o Mestre Profeta precisa
// poder aplicar o efeito de uma transferência aprovada (muda academiaId do
// aluno) em qualquer núcleo do grupo, igual ao admin já podia — mesmo nível
// de confiança que ele já tem em leitura (souFundador() acima).
// Cláusula "aceitar transferência": o gestor do núcleo de DESTINO pode mover
// um aluno PARA o próprio núcleo (request academiaId == o núcleo dele), sem
// mexer em papéis, notas, acesso geral nem no núcleo que o aluno administra.
// É o efeito do botão "Aceitar aluno" em Solicitações → Transferências.
allow update: if ehAdmin() || souFundador() ||
(ehGestor() && resource.data.academiaId == minhaAcademiaGerenciada() && academiaInalterada() && papeisInalterados() && acessoGeralInalterado()) ||
(ehGestor() && request.resource.data.academiaId == minhaAcademiaGerenciada() && papeisInalterados() && academiaGerenciadaInalterada() && notasInalteradas() && acessoGeralInalterado()) ||
(souInstrutorDoAluno() && academiaInalterada() && papeisInalterados() && academiaGerenciadaInalterada() && acessoGeralInalterado()) ||
(request.auth.uid == uid && papeisInalterados() && academiaInalterada() && academiaGerenciadaInalterada() && notasInalteradas() && acessoGeralInalterado());

allow delete: if ehAdmin();
}

match /usuarios/{uid}/avaliacoes/{id} {
function alunoDoMeuNucleo() {
return get(/databases/$(database)/documents/usuarios/$(uid)).data.academiaId == minhaAcademiaGerenciada();
}
function souInstrutorDesteAluno() {
return ehInstrutor() && get(/databases/$(database)/documents/usuarios/$(uid)).data.instrutorUid == request.auth.uid;
}
allow read: if logado() && (request.auth.uid == uid || ehAdmin() || souFundador() || (ehGestor() && alunoDoMeuNucleo()) || souInstrutorDesteAluno());
allow create: if ehAdmin() || (ehGestor() && alunoDoMeuNucleo()) || souInstrutorDesteAluno();
}

match /nucleos/{id} {
allow read: if true;
// souFundador() aditivo: aprovar uma solicitação de mensalidade no Painel
// do Fundador precisa gravar o novo valor no próprio núcleo.
allow write: if ehAdmin() || souFundador();
}

    match /presencas/{id} {
      // souFundador() aditivo: o Painel do Fundador mostra uma "presença
      // geral" real do grupo inteiro (mesmo motivo dos blocos de
      // solicitacoes/pagamentos acima) — só leitura, cada aluno continua
      // só podendo criar/editar a própria presença.
      allow read: if logado() && (
        resource.data.uid == request.auth.uid ||
        ehAdmin() ||
        souFundador() ||
        (ehGestor() && resource.data.nucleoId == minhaAcademiaGerenciada())
      );
      allow create: if logado() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.confirmadoAos30 == false;
      allow update: if logado() &&
        resource.data.uid == request.auth.uid &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.nucleoId == resource.data.nucleoId &&
        request.resource.data.entradaEm == resource.data.entradaEm;
      allow delete: if ehAdmin();
    }

match /solicitacoes/{id} {
// Além do próprio solicitante e do admin, o mestre/professor responsável pelo
// núcleo também precisa ler os pedidos que chegam PARA o próprio núcleo (vínculo
// de parentesco de um aluno, ou transferência de aluno pedindo pra entrar) —
// sem isso, o botão "Aprovar" dessas duas telas nunca funciona pra quem não é admin.
// souFundador() aqui é aditivo: o Mestre Profeta (acessoGeral, sem o papel
// literal 'admin') precisa enxergar as solicitações de TODOS os núcleos pra
// o Painel do Fundador mostrar números reais do grupo inteiro — só leitura,
// aprovar/rejeitar continua exigindo ehAdmin() ou ser o gestor do próprio núcleo.
// Última cláusula (dadosPedido.destinoId): o professor do núcleo de DESTINO
// de uma transferência precisa ler o pedido pra aceitar/recusar o aluno —
// ele não é o solicitante nem o gestor do núcleo de origem, então sem isso
// a lista "Transferências aguardando seu aceite" era negada pelas regras.
allow read: if ehAdmin() || souFundador() || (ehGestor() && (
resource.data.solicitanteUid == request.auth.uid ||
resource.data.academiaId == minhaAcademiaGerenciada() ||
resource.data.dadosPedido.destinoId == minhaAcademiaGerenciada()
));
allow create: if ehGestor() &&
request.resource.data.solicitanteUid == request.auth.uid &&
request.resource.data.academiaId == minhaAcademiaGerenciada() &&
request.resource.data.status == 'pendente';
// Só o admin aprova/rejeita pedidos de mensalidade e evento (decisão financeira
// sobe pro admin, por desenho). Vínculo de parentesco e transferência PARA o
// próprio núcleo, o mestre/professor responsável pode aprovar/rejeitar sozinho —
// e só pode mudar o campo status, nada mais no documento.
// souFundador() aditivo: o Painel do Fundador aprova/rejeita solicitações de
// QUALQUER tipo e núcleo (mensalidade, evento, transferência, vínculo de
// família), igual ao admin — é o mesmo alcance que ele já tem em leitura.
allow update: if ehAdmin() || souFundador() || (
ehGestor() &&
resource.data.academiaId == minhaAcademiaGerenciada() &&
resource.data.tipo in ['vinculo_familia', 'transferencia'] &&
request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
) || (
// Professor do núcleo de DESTINO aceitando/recusando uma transferência
// dirigida a ele — só pode mudar o campo status.
ehGestor() &&
resource.data.tipo == 'transferencia' &&
resource.data.dadosPedido.destinoId == minhaAcademiaGerenciada() &&
request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
);
// Quem enviou o pedido pode cancelar (apagar) enquanto ele ainda estiver
// pendente — antes só o admin conseguia apagar, então quem se arrependia
// de um pedido de mensalidade/evento/transferência ficava travado.
allow delete: if ehAdmin() || souFundador() ||
(logado() && resource.data.solicitanteUid == request.auth.uid && resource.data.status == 'pendente');
}

match /eventos/{id} {
allow read: if logado();
// souFundador() aditivo: aprovar uma solicitação de evento/batizado no
// Painel do Fundador precisa criar o documento em eventos.
allow write: if ehAdmin() || souFundador();
}

match /avisos/{id} {
allow read: if logado();
// souFundador() aditivo em create/update/delete: o Mestre Profeta também
// publica/exclui avisos (inclusive "Geral", academiaId nulo), igual ao
// admin — sem isso o botão "Excluir aviso" do Painel do Fundador aparece
// na tela mas a exclusão falha por permissão, igual já aconteceu antes
// com solicitações/eventos/núcleos.
allow create: if ehAdmin() || souFundador() || (ehGestor() && request.resource.data.academiaId == minhaAcademiaGerenciada());
allow update, delete: if ehAdmin() || souFundador();
}

match /materiais/{id} {
allow read: if logado();
allow write: if ehGestor();
}

// Conteúdo de formação (vídeos, conduta, ética, preparação de graduação),
// curado pelo Admin Master. Visível ao próprio alvo (instrutor/professor),
// ao mestre/professor que supervisiona, e ao Admin.
match /materiaisFormacao/{id} {
allow read: if ehAdmin() || ehGestor() || ehInstrutor();
allow write: if ehAdmin();
}

// Pagamentos manuais (mensalidade paga/não paga) — restrito ao próprio
// núcleo de quem lança, exceto o Admin que vê/gerencia tudo.
match /pagamentos/{id} {
// souFundador() aditivo pelo mesmo motivo do bloco de solicitacoes acima —
// Financeiro do grupo e Árvore do grupo precisam de leitura real de todos
// os núcleos pro Mestre Profeta, sem abrir escrita além do que já existia.
allow read: if logado() && (resource.data.alunoId == request.auth.uid || ehAdmin() || souFundador() || (ehGestor() && resource.data.academiaId == minhaAcademiaGerenciada()));
allow create: if ehAdmin() || (ehGestor() && request.resource.data.academiaId == minhaAcademiaGerenciada());
allow update, delete: if ehAdmin() || (ehGestor() && resource.data.academiaId == minhaAcademiaGerenciada());
}

// Despesas administrativas do grupo (marketing, jurídico etc.) lançadas
// pelo Admin Master, com rateio individual por responsável de núcleo.
match /despesasAdministrativas/{id} {
allow read: if ehAdmin();
allow write: if ehAdmin();
}

// Parcela individual do rateio de uma despesa — cada responsável só vê e
// só pode marcar como paga a própria parcela; quem cria/edita o valor é o Admin.
match /rateios/{id} {
allow read: if ehAdmin() || (logado() && resource.data.responsavelUid == request.auth.uid);
allow create, delete: if ehAdmin();
allow update: if ehAdmin() || (
logado() && resource.data.responsavelUid == request.auth.uid &&
request.resource.data.responsavelUid == resource.data.responsavelUid &&
request.resource.data.valor == resource.data.valor &&
request.resource.data.despesaId == resource.data.despesaId
);
}

match /academias/{id} {
allow read, write: if true;
}
match /admins/{id} {
allow read, write: if true;
}
match /alunos/{id} {
allow read, write: if true;
}
match /siteConteudo/{id} {
allow read, write: if true;
}
match /site_agenda/{id} {
allow read, write: if true;
}
match /site_equipe/{id} {
allow read, write: if true;
}
match /site_locais/{id} {
allow read, write: if true;
}
match /site_loja/{id} {
allow read, write: if true;
}
}
}
