// Regras do Cloud Firestore — Capoeira Liberdade e Expressão
// Publicação: automática pelo GitHub Actions (.github/workflows/firebase.yml)
// a cada upload nesta pasta. Também dá pra colar no Console: Firestore → Regras.
// Testes: tests/regras (rodam no GitHub antes de publicar).
rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

function logado() { return request.auth != null; }
function meuPerfil() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
function meusPapeis() { return meuPerfil().papeis; }
// PAPÉIS DE ADMINISTRAÇÃO (08/10/2026 — separação plataforma x escola):
//   'plataforma' = dono da AtletaPay (Mega painel, todas as escolas, e-mails, cobrança). Só ele é global.
//   'admin'      = Admin Master de UMA escola (ex.: Liberdade e Expressão): manda em tudo da
//                  PRÓPRIA escola e em nada das outras nem da plataforma.
function ehPlataforma() { return logado() && 'plataforma' in meusPapeis(); }
function adminDeEscola() { return logado() && 'admin' in meusPapeis() && minhaEscola() != ''; }
// O registro desta regra é da minha escola? Leitura/edição/remoção olham o documento gravado
// (sem .get(), para o Firestore provar as consultas filtradas por escolaId); criação olha o novo
// (sem o campo, o servidor completa com a escola de quem grava — functions/src/escolas.js).
function registroDaMinhaEscola() {
return resource != null ? resource.data.escolaId == minhaEscola()
                        : request.resource.data.get('escolaId', minhaEscola()) == minhaEscola();
}
// "Admin" nas regras = a plataforma em qualquer lugar, ou o Admin da escola só no que é da escola dele.
function ehAdmin() { return ehPlataforma() || (adminDeEscola() && registroDaMinhaEscola()); }
// Admin da escola nº 1 (Liberdade): coleções antigas sem escolaId (site, config, financeiro do grupo).
function adminDaEscolaPadrao() { return adminDeEscola() && minhaEscola() == 'liberdade'; }
// Admin da escola e (registro de outra coleção, de um núcleo ou de um cadastro).
function adminDa(e) { return adminDeEscola() && e == minhaEscola(); }
function admGeral() { return ehPlataforma() || adminDaEscolaPadrao(); }
function ehGestor() { return logado() && meusPapeis().hasAny(['admin', 'mestre']); }
function ehInstrutor() { return logado() && 'instrutor' in meusPapeis(); }
// Fundador (acessoGeral) ou Admin da escola: os poderes de dono valem só DENTRO da própria escola
// (todo uso abaixo compara com minhaEscola()).
function souFundador() { return logado() && (meuPerfil().get('acessoGeral', false) == true || 'admin' in meusPapeis()); }
function minhaAcademiaGerenciada() { return meuPerfil().get('academiaGerenciadaId', null); }
function mudou() { return request.resource.data.diff(resource.data).affectedKeys(); }
// Multi-escola: a escola de quem está logado vem no login (custom claim gravado pelo servidor
// em functions/src/escolas.js). Login sem o claim ainda (conta recém-criada, nos primeiros
// segundos) não é de escola nenhuma: não lê conteúdo de escola até o app renovar o login.
function minhaEscola() { return request.auth.token.get('escolaId', ''); }
// Conteúdo de escola (eventos, avisos, materiais, stories, campeonatos): sem .get()/padrão,
// para o Firestore conseguir provar as consultas em lista feitas com where('escolaId', '==', …).
function daMinhaEscola() { return resource.data.escolaId == minhaEscola(); }
function novoDaMinhaEscola() { return request.resource.data.escolaId == minhaEscola(); }
// escolaId é do SERVIDOR (functions/src/escolas.js deduz e corrige): o app nunca troca.
function escolaInalterada() { return request.resource.data.get('escolaId', null) == resource.data.get('escolaId', null); }
// Fundador (acessoGeral = dono da escola): os poderes valem só DENTRO da própria escola.
// e = escolaId do registro. Em regra usada por consulta em lista, passe resource.data.escolaId
// direto (sem .get()/padrão), para o Firestore provar pelo where('escolaId', '==', …).
function fundadorDa(e) { return souFundador() && e == minhaEscola(); }
// Escola de um cadastro / de um núcleo (para registros que só guardam o uid ou o núcleo).
function escolaDoUsuario(u) { return get(/databases/$(database)/documents/usuarios/$(u)).data.get('escolaId', ''); }
function escolaDoNucleo(n) { return get(/databases/$(database)/documents/nucleos/$(n)).data.get('escolaId', 'liberdade'); }
// Núcleo citado num registro novo (post, pedido): vazio, apagado ou da minha escola. O servidor
// deduz a escola pelo núcleo — sem isto, citar o núcleo de outra escola "mudaria" o registro de escola.
function nucleoDaMinhaEscolaOuNenhum(n) {
return n == null || n == '' || !exists(/databases/$(database)/documents/nucleos/$(n)) || escolaDoNucleo(n) == minhaEscola();
}
// Documento novo: se o app mandou a escola, tem que ser a de quem grava (quando falta, o servidor completa).
function escolaNovaOk() { return request.resource.data.get('escolaId', minhaEscola()) == minhaEscola(); }
// config/* (brasões, presidente…) ainda é da escola nº 1; vira por escola na ativação (etapa 2).
function fundadorDaEscolaPadrao() { return fundadorDa('liberdade'); }
// .get(campo, padrão): cadastro antigo sem o campo não trava a gravação.
function papeisInalterados() { return request.resource.data.get('papeis', null) == resource.data.get('papeis', null); }
function academiaInalterada() { return request.resource.data.get('academiaId', null) == resource.data.get('academiaId', null); }
function academiaGerenciadaInalterada() { return request.resource.data.get('academiaGerenciadaId', null) == resource.data.get('academiaGerenciadaId', null); }
function notasInalteradas() { return request.resource.data.get('notas', null) == resource.data.get('notas', null); }
function acessoGeralInalterado() { return request.resource.data.get('acessoGeral', false) == resource.data.get('acessoGeral', false); }
// Id de documento escolhido pelo app: só letras, números, _ e - (o id aparece em telas e
// atributos HTML — aspas ou < > num id viravam injeção; auditoria 08/10).
function idSeguro(i) { return i.matches('^[A-Za-z0-9_-]{1,80}$'); }
function souInstrutorDoAluno() { return ehInstrutor() && resource.data.get('instrutorUid', null) == request.auth.uid; }
function responsavelInalterado() { return request.resource.data.get('responsavelUid', null) == resource.data.get('responsavelUid', null); }
// Auditoria 08/10: ninguém além do Admin põe ou tira o papel 'admin' (antes o Fundador de
// QUALQUER escola conseguia se dar 'admin' no próprio cadastro e virar Admin da plataforma).
function adminInalterado() { return ('admin' in request.resource.data.get('papeis', [])) == ('admin' in resource.data.get('papeis', [])); }
// 'plataforma' (dono da AtletaPay) só a própria plataforma põe ou tira — nem o Admin de escola.
function plataformaInalterada() { return ('plataforma' in request.resource.data.get('papeis', [])) == ('plataforma' in resource.data.get('papeis', [])); }
// Núcleo que existe E é da minha escola (sem padrão: núcleo sem escola não serve).
// O servidor deduz a escola do cadastro pelo núcleo (functions/src/escolas.js), então
// apontar academiaId/academiaGerenciadaId para núcleo de outra escola = mudar a pessoa de escola.
function nucleoExisteNaMinhaEscola(n) {
return exists(/databases/$(database)/documents/nucleos/$(n)) &&
get(/databases/$(database)/documents/nucleos/$(n)).data.get('escolaId', '') == minhaEscola();
}
function nucleoOkOuVazio(n) { return n == null || n == '' || nucleoExisteNaMinhaEscola(n); }
function nucleosDoCadastroNaMinhaEscola() {
return (academiaInalterada() || nucleoOkOuVazio(request.resource.data.get('academiaId', null))) &&
(academiaGerenciadaInalterada() || nucleoOkOuVazio(request.resource.data.get('academiaGerenciadaId', null)));
}
// Transferência aceita pelo núcleo de DESTINO: tem que existir o pedido pendente para ESTE
// aluno, saindo do núcleo onde ele está hoje e vindo para o meu (id do pedido no cadastro).
function transferenciaPendenteParaMim(uid) {
let s = get(/databases/$(database)/documents/solicitacoes/$(request.resource.data.transferenciaId)).data;
return s.tipo == 'transferencia' && s.status == 'pendente' && s.get('escolaId', '') == minhaEscola() &&
s.dadosPedido.alunoUid == uid && s.dadosPedido.destinoId == minhaAcademiaGerenciada() &&
s.academiaId == resource.data.get('academiaId', '');
}
// Brasões: 'brasoesAdmin' (qualquer brasão, até automático) só o Admin Master
// grava; 'brasoesManuais' só Admin, Fundador e o responsável do núcleo do aluno.
// 'brasoesBloqueados' (brasão removido pelo Admin Master — ferramenta de teste) também só o Admin.
function brasoesAdminInalterados() { return request.resource.data.get('brasoesAdmin', null) == resource.data.get('brasoesAdmin', null) &&
request.resource.data.get('brasoesBloqueados', null) == resource.data.get('brasoesBloqueados', null); }
function brasoesManuaisInalterados() { return request.resource.data.get('brasoesManuais', null) == resource.data.get('brasoesManuais', null); }
// Campos que a própria pessoa NÃO pode mudar no próprio cadastro: graduação,
// histórico, quem avalia, quem é o responsável legal, idade (define se é
// menor) e o total de brasões (calculado no servidor).
function camposTravadosDoProprio() {
return ['cordaoAtual', 'historicoGraduacoes', 'instrutorUid', 'responsavelUid', 'idade', 'dataNasc',
'statusAtual', 'brasoesTotal', 'eventosConfirmados', 'cardsCompartilhados', 'origemTransferenciaDireta', 'academiaAnteriorId',
'carteirinha', 'isentoMensalidade', 'competicoes', 'escolaId', 'grausAtual', 'transferenciaId'];
}

match /usuarios/{uid} {
allow read: if logado() && (
request.auth.uid == uid ||
ehAdmin() ||
fundadorDa(resource.data.escolaId) ||
(ehGestor() && resource.data.academiaId == minhaAcademiaGerenciada()) ||
(ehInstrutor() && resource.data.instrutorUid == request.auth.uid) ||
resource.data.responsavelUid == request.auth.uid
);

// Autocadastro (inscrição): sempre aluno, Iniciante, sem núcleo próprio, sem
// acesso geral, sem brasões, sem notas e sem responsável definido por conta própria.
// Plataforma cria em qualquer escola; o Admin da escola só na DELE (núcleos da escola, sem 'plataforma').
allow create: if ehPlataforma() || (adminDeEscola() && request.resource.data.get('escolaId', minhaEscola()) == minhaEscola() &&
!('plataforma' in request.resource.data.get('papeis', [])) &&
nucleoOkOuVazio(request.resource.data.get('academiaId', null)) && nucleoOkOuVazio(request.resource.data.get('academiaGerenciadaId', null))) || (
request.auth.uid == uid &&
request.resource.data.papeis == ['aluno'] &&
!request.resource.data.keys().hasAny(['acessoGeral', 'brasoesAdmin', 'brasoesManuais', 'brasoesBloqueados', 'eventosConfirmados', 'cardsCompartilhados', 'instrutorUid',
'historicoGraduacoes', 'brasoesTotal', 'origemTransferenciaDireta', 'academiaAnteriorId', 'carteirinha', 'isentoMensalidade', 'competicoes', 'escolaId', 'grausAtual', 'transferenciaId']) &&
request.resource.data.get('academiaGerenciadaId', null) == null &&
// núcleo escolhido na inscrição: vazio ou um núcleo que existe e está ativo
(request.resource.data.get('academiaId', null) == null || request.resource.data.get('academiaId', '') == '' ||
 get(/databases/$(database)/documents/nucleos/$(request.resource.data.academiaId)).data.get('ativo', true) != false) &&
request.resource.data.get('cordaoAtual', 'Iniciante') == 'Iniciante' &&
request.resource.data.get('notas', {}) == {} &&
request.resource.data.get('responsavelUid', null) == null &&
request.resource.data.get('statusAtual', 'Ativo') == 'Ativo'
);

// Fundador: aplica transferências aprovadas em qualquer núcleo DA PRÓPRIA ESCOLA.
// "Aceitar transferência": o gestor do núcleo de DESTINO move um aluno PARA o
// próprio núcleo sem mexer em papéis, notas, acesso geral nem núcleo administrado.
// Auditoria 08/10 (antes: Fundador sem trava nenhuma; gestor mexia no núcleo administrado,
// no responsável legal e no PRÓPRIO cordão; "aceitar transferência" puxava gente de qualquer escola):
//   • Fundador: não mexe no papel 'admin', no acesso geral nem no responsável legal, e só aponta
//     núcleo (onde treina / que administra) da PRÓPRIA escola;
//   • gestor e instrutor: nunca no próprio cadastro, nunca no responsável legal nem no núcleo administrado;
//   • aceitar transferência: só com o pedido pendente (transferenciaId) e só os campos da transferência.
// Plataforma: tudo. Admin da escola: qualquer cadastro DA ESCOLA DELE, sem trocar a escola, sem
// apontar núcleo de outra escola e sem mexer no papel 'plataforma' (que ninguém mais mexe).
allow update: if ehPlataforma() || (plataformaInalterada() && ((adminDeEscola() && resource.data.escolaId == minhaEscola() && escolaInalterada() && nucleosDoCadastroNaMinhaEscola()) || (escolaInalterada() && (
(fundadorDa(resource.data.get('escolaId', '')) && brasoesAdminInalterados() && adminInalterado() && acessoGeralInalterado() &&
 responsavelInalterado() && nucleosDoCadastroNaMinhaEscola()) ||
(ehGestor() && request.auth.uid != uid && resource.data.academiaId == minhaAcademiaGerenciada() && resource.data.get('escolaId', '') == minhaEscola() &&
 academiaInalterada() && academiaGerenciadaInalterada() && papeisInalterados() && acessoGeralInalterado() && brasoesAdminInalterados() && responsavelInalterado()) ||
(ehGestor() && request.auth.uid != uid && resource.data.get('escolaId', '') == minhaEscola() &&
 request.resource.data.academiaId == minhaAcademiaGerenciada() &&
 mudou().hasOnly(['academiaId', 'academiaNome', 'academiaAnteriorId', 'origemTransferenciaDireta', 'transferenciaId']) &&
 transferenciaPendenteParaMim(uid)) ||
(souInstrutorDoAluno() && request.auth.uid != uid && academiaInalterada() && papeisInalterados() && academiaGerenciadaInalterada() && acessoGeralInalterado() && brasoesAdminInalterados() && brasoesManuaisInalterados()
&& responsavelInalterado() && !mudou().hasAny(['isentoMensalidade', 'carteirinha'])) ||
(request.auth.uid == uid && papeisInalterados() && academiaInalterada() && academiaGerenciadaInalterada() && notasInalteradas() && acessoGeralInalterado() && brasoesAdminInalterados() && brasoesManuaisInalterados()
&& !mudou().hasAny(camposTravadosDoProprio())) ||
// Responsável legal: só a ficha de atenção e inclusão do dependente (condições, apoios, orientações) — nada mais.
(resource.data.responsavelUid == request.auth.uid && mudou().hasOnly(['inclusao']))))));

allow delete: if ehAdmin();
}

match /usuarios/{uid}/avaliacoes/{id} {
function alunoDoMeuNucleo() {
return get(/databases/$(database)/documents/usuarios/$(uid)).data.academiaId == minhaAcademiaGerenciada();
}
function souInstrutorDesteAluno() {
return ehInstrutor() && get(/databases/$(database)/documents/usuarios/$(uid)).data.instrutorUid == request.auth.uid;
}
allow read: if logado() && (request.auth.uid == uid || ehPlataforma() || fundadorDa(escolaDoUsuario(uid)) || (ehGestor() && alunoDoMeuNucleo()) || souInstrutorDesteAluno());
allow create: if ehPlataforma() || adminDa(escolaDoUsuario(uid)) || (ehGestor() && alunoDoMeuNucleo()) || souInstrutorDesteAluno();
}

// Aparelhos que recebem notificação push (token do Firebase Cloud Messaging).
// Só o dono lê e grava; quem envia é o servidor (Cloud Functions).
match /usuarios/{uid}/dispositivos/{id} {
allow read, delete: if logado() && request.auth.uid == uid;
allow create, update: if logado() && request.auth.uid == uid &&
request.resource.data.keys().hasOnly(['token', 'plataforma', 'base', 'criadoEm', 'atualizadoEm']) &&
request.resource.data.token is string && request.resource.data.token.size() < 400;
}

// Central de notificações: escrita só pelo servidor; o dono lê, marca como
// lida e apaga.
match /notificacoes/{uid}/itens/{id} {
allow read, delete: if logado() && request.auth.uid == uid;
// celebradoEm: a festa (troca de cordão / brasão novo) já apareceu na tela principal.
allow update: if logado() && request.auth.uid == uid && mudou().hasOnly(['lida', 'lidaEm', 'celebradoEm', 'compartilhadoEm']) &&
// compartilhou o card: marca UMA vez (apagar e marcar de novo somava o brasão sem fim)
(!('compartilhadoEm' in mudou()) || resource.data.get('compartilhadoEm', null) == null);
allow create: if false;
}

// Pedidos do Admin ao servidor (excluir conta — LGPD, recalcular brasões).
// O servidor executa e grava o resultado; ninguém edita depois.
// Plataforma: todos os pedidos. Admin da escola: só os da própria escola sobre UM atleta (o servidor
// confere de novo que o atleta é da escola dele — functions/src/rotinas.js). Migrar, recalcular
// todo mundo e testar o e-mail da plataforma são só da plataforma.
match /comandos/{id} {
allow read: if ehPlataforma() || (adminDeEscola() && resource.data.porUid == request.auth.uid);
allow create: if request.resource.data.porUid == request.auth.uid &&
request.resource.data.status == 'pendente' && (
(ehPlataforma() && request.resource.data.tipo in ['excluirConta', 'recalcularAtleta', 'recalcularTodos', 'migrar', 'desfazerGraduacao', 'testarEmail']) ||
(adminDeEscola() && request.resource.data.tipo in ['excluirConta', 'recalcularAtleta', 'desfazerGraduacao'] &&
 request.resource.data.get('uid', '') is string && request.resource.data.get('uid', '') != '' &&
 escolaDoUsuario(request.resource.data.uid) == minhaEscola()));
allow update, delete: if false;
}

// Registro de auditoria (quem fez o quê). Só o servidor grava; ninguém edita.
match /auditoria/{id} {
allow read: if ehPlataforma() || fundadorDa(resource.data.escolaId);
allow write: if false;
}

// Apresentação em vídeo de cada Instrutor/Professor/Mestre (conta.js).
match /apresentacoes/{uid} {
function perfilDela() { return get(/databases/$(database)/documents/usuarios/$(uid)).data; }
function podeTerVideo() {
return meuPerfil().get('cordaoAtual', '') in ['Instrutor', 'Professor', 'Mestre', 'Mestre/Presidente']
|| meuPerfil().get('papeis', []).hasAny(['mestre', 'instrutor'])
|| meuPerfil().get('acessoGeral', false) == true;
}
function podeEditar() {
return 'admin' in meuPerfil().get('papeis', [])
|| (meuPerfil().get('acessoGeral', false) == true && perfilDela().get('escolaId', '') == minhaEscola())
|| (request.auth.uid == uid && podeTerVideo())
|| ('mestre' in meuPerfil().get('papeis', [])
    && meuPerfil().get('academiaGerenciadaId', null) != null
    && perfilDela().get('academiaId', '') == meuPerfil().get('academiaGerenciadaId', null));
}
function dadosValidos() {
return request.resource.data.keys().hasOnly(['videoUrl', 'inicioNome', 'titulo', 'duracao', 'atualizadoEm', 'porNome', 'porUid'])
&& request.resource.data.videoUrl is string
&& request.resource.data.videoUrl.size() < 1500
&& (request.resource.data.videoUrl.matches('https://.*') || request.resource.data.videoUrl.matches('apresentacoes/.*'));
}
allow read: if request.auth != null;
allow create, update: if request.auth != null && podeEditar() && dadosValidos();
allow delete: if request.auth != null && podeEditar();
}

match /nucleos/{id} {
allow read: if true;
// O Fundador cuida dos núcleos da PRÓPRIA escola e não muda a escola de um núcleo
// (os alunos herdam a escola pelo núcleo). Ligar núcleo a outra escola: só o Admin.
// Auditoria 08/10: sem escolaId o servidor etiquetava o núcleo como da escola nº 1 — o Fundador
// de outra escola "criava" um núcleo dentro da Liberdade. Agora a escola vem sempre e é a minha.
allow create: if ehPlataforma() || (souFundador() && request.resource.data.get('escolaId', '') == minhaEscola());
allow update: if ehPlataforma() || (souFundador() && resource.data.get('escolaId', '') == minhaEscola() && escolaInalterada());
allow delete: if ehPlataforma() || (souFundador() && resource.data.get('escolaId', '') == minhaEscola());
}

match /presencas/{id} {
// O professor do núcleo VISITADO também enxerga a presença de um aluno de
// fora que treinou com ele (Face ID do aluno).
allow read: if logado() && (
resource.data.uid == request.auth.uid ||
ehAdmin() ||
fundadorDa(resource.data.escolaId) ||
(ehGestor() && resource.data.nucleoId == minhaAcademiaGerenciada()) ||
(ehGestor() && resource.data.nucleoVisitadoId == minhaAcademiaGerenciada())
);
// Presença só é criada pelo RESPONSÁVEL do núcleo (Face ID, foto da turma ou
// marcação manual), pelo Fundador ou pelo Admin — já nasce confirmada.
// Foto da turma ('faceid-foto'): o professor pode lançar o treino de até 7 dias
// atrás (foto de ontem), nunca no futuro.
allow create: if logado() &&
request.resource.data.origem in ['faceid', 'manual', 'faceid-foto'] &&
(request.resource.data.origem != 'faceid-foto' || (
request.resource.data.entradaEm is timestamp &&
request.resource.data.entradaEm > request.time - duration.value(8, 'd') &&
request.resource.data.entradaEm < request.time + duration.value(10, 'm'))) &&
request.resource.data.registradoPor == request.auth.uid && escolaNovaOk() && (
ehPlataforma() || fundadorDa(escolaDoNucleo(request.resource.data.nucleoId)) ||
(ehGestor() && request.resource.data.nucleoId == minhaAcademiaGerenciada())
);
allow update: if logado() &&
resource.data.uid == request.auth.uid &&
request.resource.data.uid == resource.data.uid && escolaInalterada() &&
request.resource.data.nucleoId == resource.data.nucleoId &&
request.resource.data.entradaEm == resource.data.entradaEm;
allow delete: if ehAdmin();
}

match /solicitacoes/{id} {
// Leitura: quem pediu, Admin, Fundador e o responsável do núcleo envolvido
// (origem ou destino de uma transferência).
allow read: if (logado() && resource.data.solicitanteUid == request.auth.uid) || ehPlataforma() || fundadorDa(resource.data.escolaId) || (ehGestor() && (
resource.data.academiaId == minhaAcademiaGerenciada() ||
resource.data.dadosPedido.destinoId == minhaAcademiaGerenciada()
));
// Gestor pede mensalidade/evento/transferência para o próprio núcleo.
// Qualquer pessoa pede a EXCLUSÃO DA PRÓPRIA CONTA (LGPD).
allow create: if idSeguro(id) && escolaNovaOk() && ((ehGestor() &&
request.resource.data.solicitanteUid == request.auth.uid &&
request.resource.data.academiaId == minhaAcademiaGerenciada() &&
request.resource.data.status == 'pendente') || (
logado() &&
request.resource.data.tipo == 'exclusao_conta' &&
request.resource.data.solicitanteUid == request.auth.uid &&
// núcleo informado tem que ser da escola de quem pede (o servidor deduz a escola por ele)
nucleoDaMinhaEscolaOuNenhum(request.resource.data.get('academiaId', null)) &&
request.resource.data.status == 'pendente'));
// Gestor só RESOLVE um pedido pendente (não reabre um já resolvido — auditoria 08/10).
allow update: if ehPlataforma() || (fundadorDa(resource.data.get('escolaId', '')) && escolaInalterada()) || (
ehGestor() &&
resource.data.academiaId == minhaAcademiaGerenciada() &&
resource.data.tipo in ['vinculo_familia', 'transferencia'] &&
mudou().hasOnly(['status']) && resource.data.status == 'pendente' && request.resource.data.status in ['aprovado', 'rejeitado']
) || (
ehGestor() &&
resource.data.tipo == 'transferencia' &&
resource.data.dadosPedido.destinoId == minhaAcademiaGerenciada() &&
mudou().hasOnly(['status']) && resource.data.status == 'pendente' && request.resource.data.status in ['aprovado', 'rejeitado']
);
allow delete: if ehPlataforma() || fundadorDa(resource.data.get('escolaId', '')) ||
(logado() && resource.data.solicitanteUid == request.auth.uid && resource.data.status == 'pendente');
}

match /eventos/{id} {
allow read: if logado() && (daMinhaEscola() || ehPlataforma());
allow create: if ehPlataforma() || (idSeguro(id) && souFundador() && novoDaMinhaEscola() && nucleoDaMinhaEscolaOuNenhum(request.resource.data.get('academiaId', null)));
allow update: if ehPlataforma() || (souFundador() && daMinhaEscola() && escolaInalterada());
allow delete: if ehPlataforma() || (souFundador() && daMinhaEscola());
}
// Inscrição no evento ("Eu vou"): cada pessoa marca/desmarca só a si mesma, em evento da própria escola.
match /eventos/{id}/confirmados/{uid} {
function eventoDaMinhaEscola() { return get(/databases/$(database)/documents/eventos/$(id)).data.escolaId == minhaEscola(); }
allow read: if logado() && (eventoDaMinhaEscola() || ehPlataforma());
allow create, update: if logado() && request.auth.uid == uid && eventoDaMinhaEscola() &&
request.resource.data.keys().hasOnly(['nome', 'em', 'academiaId', 'cordaoAtual', 'fotoUrl']);
allow delete: if logado() && ((request.auth.uid == uid && eventoDaMinhaEscola()) || ehPlataforma() || (souFundador() && eventoDaMinhaEscola()));
}

// Campeonatos (interno e externo). Organiza: Admin, Fundador e o responsável do
// núcleo organizador (ou qualquer responsável quando é do grupo inteiro).
// Atletas se inscrevem a si mesmos; o organizador inscreve qualquer um (inclusive
// atletas fictícios da demonstração) e é o único que mexe nas chaves.
match /campeonatos/{id} {
function camp() { return resource.data; }
// Organiza: Admin; ou, DENTRO da escola do campeonato, o Fundador e o responsável do núcleo organizador.
function organizo(d) { return ehPlataforma() || (d.get('escolaId', '') == minhaEscola() && (souFundador() || (ehGestor() && (d.get('academiaId', null) == null || d.academiaId == minhaAcademiaGerenciada() || d.get('organizadorUid', '') == request.auth.uid)))); }
function statusOk(d) { return d.get('status', '') in ['inscricoes', 'categorias', 'chaves', 'andamento', 'encerrado']; }
// Campeonato "entre escolas" (tipo externo): qualquer atleta logado vê e pode se inscrever.
function aberto(d) { return d.get('tipo', 'interno') == 'externo'; }
allow read: if logado() && (daMinhaEscola() || resource.data.tipo == 'externo' || ehPlataforma());
allow create: if ehGestor() && request.resource.data.organizadorUid == request.auth.uid && statusOk(request.resource.data) &&
request.resource.data.nome is string && request.resource.data.nome.size() <= 80 &&
(ehPlataforma() || (novoDaMinhaEscola() && (souFundador() || request.resource.data.get('academiaId', null) == minhaAcademiaGerenciada())));
allow update: if organizo(camp()) && statusOk(request.resource.data) && (ehPlataforma() || escolaInalterada()) &&
(camp().status != 'encerrado' || ehPlataforma() || souFundador()) &&
// organizador e marcas do servidor (premiação feita) não mudam pelo app (auditoria 08/10)
(ehPlataforma() || adminDa(camp().get('escolaId', '')) || (request.resource.data.get('organizadorUid', '') == camp().get('organizadorUid', '') &&
 request.resource.data.get('premiadoEm', null) == camp().get('premiadoEm', null) &&
 request.resource.data.get('premiados', null) == camp().get('premiados', null) &&
 request.resource.data.get('participantesReais', null) == camp().get('participantesReais', null)));
allow delete: if organizo(camp());
match /inscricoes/{uid} {
function campPai() { return get(/databases/$(database)/documents/campeonatos/$(id)).data; }
function camposInsc() { return request.resource.data.keys().hasOnly(['uid', 'nome', 'apelido', 'fotoUrl', 'cordao', 'academiaId', 'academiaNome', 'sexo', 'peso', 'idade', 'categoriaId', 'demo', 'em', 'por', 'pesagemOk']); }
function possoVer() { return campPai().get('escolaId', '') == minhaEscola() || aberto(campPai()) || ehPlataforma(); }
allow read: if logado() && possoVer();
// O próprio atleta: só enquanto as inscrições estão abertas, com os próprios dados (da própria escola, ou campeonato entre escolas).
allow create, update: if logado() && camposInsc() && (
(request.auth.uid == uid && possoVer() && campPai().status == 'inscricoes' && request.resource.data.get('demo', false) == false) ||
organizo(campPai()));
allow delete: if logado() && ((request.auth.uid == uid && campPai().status == 'inscricoes') || organizo(campPai()));
}
match /chaves/{categoriaId} {
function campPai() { return get(/databases/$(database)/documents/campeonatos/$(id)).data; }
allow read: if logado() && (campPai().get('escolaId', '') == minhaEscola() || aberto(campPai()) || ehPlataforma());
allow write: if organizo(campPai()) && campPai().status != 'encerrado';
}
}

// AtletaPay (atletapay.com.br): escolas que se cadastram sozinhas. O dono é a
// conta que criou; a escola nasce 'rascunho', vira 'fila' quando o assistente
// termina e só a AtletaPay (Admin) a torna 'ativa'. escolasSlugs garante o
// endereço único atletapay.com.br/<slug> (o id É o slug: criar duas vezes falha sozinho).
// Nomes reservados: rotas e páginas da própria plataforma (mesma lista de
// atletapay/js/catalogo.js — a regra garante que ninguém pule o formulário).
function slugLivre(s) {
return s.matches('^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$') &&
!(s in ['www', 'app', 'api', 'admin', 'painel', 'master', 'suporte', 'ajuda', 'blog', 'docs', 'mail', 'email', 'ftp', 'cdn', 'static', 'assets', 'atletapay', 'redbull', 'teste', 'demo', 'login', 'conta', 'pagamentos', 'pix',
'cadastro', 'privacidade', 'termos', 'index', 'css', 'js', 'img', 'fotos', 'sitemap', 'robots', 'favicon', 'sobre', 'contato', 'planos', 'precos', 'global', 'rede', 'escolas', 'inscricao', 'entrar', 'sair']);
}
match /escolasSlugs/{slug} {
allow get: if logado();
allow list: if false;
allow create: if logado() && request.resource.data.donoUid == request.auth.uid && request.resource.data.escolaId == slug && slugLivre(slug);
allow update, delete: if ehPlataforma();
}
match /escolas/{id} {
function dono() { return logado() && resource.data.donoUid == request.auth.uid; }
function statusOk(s) { return s in ['rascunho', 'fila', 'ativa', 'pausada', 'cancelada']; }
// 'completo' = plano único (08/10/2026); os ids antigos continuam aceitos para cadastros já existentes.
function planoOk(p) { return p in ['completo', 'roda', 'nucleo', 'grupo', 'federacao']; }
allow get: if dono() || ehPlataforma();
allow list: if ehPlataforma();
allow create: if logado() && request.resource.data.donoUid == request.auth.uid && request.resource.data.slug == id &&
request.resource.data.status == 'rascunho' && planoOk(request.resource.data.plano) &&
request.resource.data.nome is string && request.resource.data.nome.size() <= 80 &&
!request.resource.data.keys().hasAny(['assinatura', 'ativadaEm', 'ativadaPor', 'escolaId', 'projeto', 'dominio', 'ativacao', 'escada', 'trialAte']) &&
slugLivre(id);
// O dono edita a própria escola, sem trocar dono/slug e só entre rascunho e fila; o Admin faz o resto.
// (dono() vem primeiro: o dono da escola não tem usuarios/{uid}, e ehAdmin() falharia ao ler o perfil.)
allow update: if (dono() && request.resource.data.donoUid == resource.data.donoUid && request.resource.data.slug == resource.data.slug &&
request.resource.data.status in ['rascunho', 'fila'] && planoOk(request.resource.data.plano) &&
!mudou().hasAny(['assinatura', 'ativadaEm', 'ativadaPor', 'escolaId', 'projeto', 'dominio', 'ativacao', 'escada']) &&
// teste grátis: gravado uma vez só, quando o cadastro sai do rascunho
(!('trialAte' in mudou()) || (resource.data.get('trialAte', null) == null && resource.data.status == 'rascunho' &&
 request.resource.data.trialAte is string && request.resource.data.trialAte.size() == 10))) || ehPlataforma();
allow delete: if ehPlataforma();
}
// Cartão público de cada escola ativa e índice de domínios próprios: só o
// servidor escreve (functions/src/escolas.js); qualquer visitante lê (site, inscrição, app).
match /escolasPublicas/{id} {
allow read: if true;
allow write: if false;
}
match /dominios/{host} {
allow get: if true;
allow list, write: if false;
}
match /donos/{uid} {
allow read: if (logado() && request.auth.uid == uid) || ehPlataforma();
allow create, update: if logado() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['nome', 'email', 'celular', 'escolaId', 'criadoEm', 'atualizadoEm', 'origem']);
allow delete: if ehPlataforma();
}

match /avisos/{id} {
allow read: if logado() && (daMinhaEscola() || ehPlataforma());
allow create: if ehPlataforma() || (idSeguro(id) && novoDaMinhaEscola() && nucleoDaMinhaEscolaOuNenhum(request.resource.data.get('academiaId', null)) &&
(souFundador() || (ehGestor() && request.resource.data.academiaId == minhaAcademiaGerenciada())));
allow update: if ehPlataforma() || (souFundador() && daMinhaEscola() && escolaInalterada());
allow delete: if ehPlataforma() || (souFundador() && daMinhaEscola());
}

match /materiais/{id} {
allow read: if logado() && (daMinhaEscola() || ehPlataforma());
allow create: if ehPlataforma() || (idSeguro(id) && ehGestor() && novoDaMinhaEscola());
allow update: if ehPlataforma() || (ehGestor() && daMinhaEscola() && escolaInalterada());
allow delete: if ehPlataforma() || (ehGestor() && daMinhaEscola());
}

match /materiaisFormacao/{id} {
allow read: if ehPlataforma() || ehGestor() || ehInstrutor();
allow write: if admGeral();
}

// Pagamentos manuais — restritos ao próprio núcleo de quem lança; Admin vê tudo.
match /pagamentos/{id} {
allow read: if logado() && (resource.data.alunoId == request.auth.uid || ehPlataforma() || fundadorDa(resource.data.escolaId) || (ehGestor() && resource.data.academiaId == minhaAcademiaGerenciada()));
allow create: if ehPlataforma() || (adminDeEscola() && escolaNovaOk() && nucleoOkOuVazio(request.resource.data.get('academiaId', null))) || (idSeguro(id) && ehGestor() && escolaNovaOk() && request.resource.data.academiaId == minhaAcademiaGerenciada() &&
// o aluno do lançamento treina no MEU núcleo (auditoria 08/10)
(request.resource.data.get('alunoId', null) == null ||
 get(/databases/$(database)/documents/usuarios/$(request.resource.data.alunoId)).data.get('academiaId', '') == minhaAcademiaGerenciada()));
allow update: if ehPlataforma() || (adminDa(resource.data.get('escolaId', '')) && escolaInalterada()) || (ehGestor() && resource.data.academiaId == minhaAcademiaGerenciada() && escolaInalterada() &&
request.resource.data.academiaId == resource.data.academiaId &&
request.resource.data.get('alunoId', null) == resource.data.get('alunoId', null));
allow delete: if ehPlataforma() || adminDa(resource.data.get('escolaId', '')) || (ehGestor() && resource.data.academiaId == minhaAcademiaGerenciada());
}

match /despesasAdministrativas/{id} {
allow read: if admGeral();
allow write: if admGeral();
}

match /rateios/{id} {
allow read: if admGeral() || (logado() && resource.data.responsavelUid == request.auth.uid);
allow create, delete: if admGeral();
allow update: if admGeral() || (
logado() && resource.data.responsavelUid == request.auth.uid &&
request.resource.data.responsavelUid == resource.data.responsavelUid &&
request.resource.data.valor == resource.data.valor &&
request.resource.data.despesaId == resource.data.despesaId
);
}

// ===== Rede Liberdade (rede social interna) =====
// perfisPublicos: o cartão público. Os campos que valem conquista ou
// segurança (cordão, núcleo, idade/menor, presenças, brasões, graduações…)
// são calculados e gravados SÓ pelo servidor (Cloud Functions). A pessoa só
// mexe nos campos de apresentação abaixo; outra pessoa só entra/sai de
// seguidores e pedidosSeguir com o PRÓPRIO uid. O responsável legal
// (usuarios.responsavelUid) administra privacidade e seguidores do menor.
match /perfisPublicos/{uid} {
function souResponsavelLegal() { return get(/databases/$(database)/documents/usuarios/$(uid)).data.get('responsavelUid', null) == request.auth.uid; }
function soMeuUidEm(campo) {
return request.resource.data.get(campo, []).toSet().size() == request.resource.data.get(campo, []).size() &&
request.resource.data.get(campo, []).removeAll(resource.data.get(campo, [])).hasOnly([request.auth.uid]) &&
resource.data.get(campo, []).removeAll(request.resource.data.get(campo, [])).hasOnly([request.auth.uid]);
}
function camposDoDono() {
return ['capaUrl', 'bio', 'apelido', 'funcoes', 'cidade', 'privado', 'seguidores', 'pedidosSeguir', 'seguindoCount', 'atualizadoEm'];
}
function tamanhosOk() {
return request.resource.data.get('bio', '').size() <= 600 &&
request.resource.data.get('apelido', '').size() <= 30 &&
request.resource.data.get('cidade', '').size() <= 60 &&
request.resource.data.get('funcoes', []).size() <= 6;
}
// Seguidor novo só sai de um pedido (aceitar) — o dono não "cria" seguidores (brasões da Rede).
function seguidoresSoDePedidos() {
return request.resource.data.get('seguidores', []).removeAll(resource.data.get('seguidores', [])).removeAll(resource.data.get('pedidosSeguir', [])).size() == 0;
}
// Multi-escola: cada escola só enxerga os cartões da própria escola (a aba Global,
// quando existir, terá o próprio recorte). A pessoa sempre lê o próprio cartão.
// Cartão que não existe: responde "não existe" em vez de "sem permissão".
allow get: if logado() && (resource == null || request.auth.uid == uid);
allow read: if logado() && (daMinhaEscola() || ehPlataforma());
allow create: if logado() && request.auth.uid == uid && request.resource.data.keys().hasOnly(camposDoDono()) && tamanhosOk() &&
request.resource.data.get('seguidores', []).size() == 0;
allow update: if logado() && (
(request.auth.uid == uid && mudou().hasOnly(camposDoDono()) && tamanhosOk() && seguidoresSoDePedidos()) ||
(souResponsavelLegal() && mudou().hasOnly(['privado', 'seguidores', 'pedidosSeguir', 'atualizadoEm']) && seguidoresSoDePedidos()) ||
(daMinhaEscola() && mudou().hasOnly(['seguidores', 'pedidosSeguir']) &&
// perfil privado: quem é de fora só PEDE (pedidosSeguir) ou deixa de seguir — entrar direto, não
(!('seguidores' in mudou()) || (soMeuUidEm('seguidores') &&
 (resource.data.get('privado', false) != true || resource.data.get('seguidores', []).hasAll(request.resource.data.get('seguidores', []))))) &&
(!('pedidosSeguir' in mudou()) || soMeuUidEm('pedidosSeguir')))
);
allow delete: if ehAdmin();
}

// posts: texto até 800 caracteres, mídias são links do Storage.
// "publico" = pode aparecer para toda a rede (não ocultado e revisão ok). Quem
// não é o autor/moderador só consegue LER posts com publico == true — assim um
// post ocultado ou uma foto de menor aguardando revisão não vaza nem pela API.
// Multi-escola: "publico" vale DENTRO da escola do post (o feed consulta com
// where('escolaId', '==', minha escola) + where('publico', '==', true)).
match /posts/{id} {
function pp(u) { return get(/databases/$(database)/documents/perfisPublicos/$(u)).data; }
function moderaEstePost() {
return ehPlataforma() || fundadorDa(resource.data.get('escolaId', '')) ||
(ehGestor() && (resource.data.autorAcademiaId == minhaAcademiaGerenciada() || resource.data.nucleoId == minhaAcademiaGerenciada()));
}
// Marcações, menções e hashtags com tamanho (cada marcação vira notificação).
function listasDoPostOk() {
return request.resource.data.get('marcados', []).size() <= 10 && request.resource.data.get('mencoes', []).size() <= 10 &&
request.resource.data.get('hashtags', []).size() <= 10;
}
function publicoCoerente(ocultoNovo, revisaoNova) {
return request.resource.data.publico == (ocultoNovo == false && revisaoNova == 'ok');
}
// Post apagado: responde "não existe" em vez de "sem permissão".
allow get: if logado() && resource == null;
allow read: if logado() && (
(resource.data.publico == true && daMinhaEscola()) ||
resource.data.autorUid == request.auth.uid ||
ehPlataforma() || fundadorDa(resource.data.escolaId) ||
(ehGestor() && (resource.data.autorAcademiaId == minhaAcademiaGerenciada() || resource.data.nucleoId == minhaAcademiaGerenciada()))
);
allow create: if logado() && idSeguro(id) &&
request.resource.data.autorUid == request.auth.uid && escolaNovaOk() &&
// O núcleo marcado no post é da escola de quem publica (o servidor deduz a escola pelo núcleo).
nucleoDaMinhaEscolaOuNenhum(request.resource.data.get('nucleoId', null)) &&
request.resource.data.texto is string && request.resource.data.texto.size() <= 800 &&
request.resource.data.get('midias', []).size() <= 4 &&
listasDoPostOk() &&
request.resource.data.get('tipo', 'post') in ['post', 'aviso'] &&
request.resource.data.oculto == false &&
request.resource.data.revisao in ['ok', 'pendente'] &&
publicoCoerente(false, request.resource.data.revisao) &&
// Menor de idade publicando foto/vídeo: sempre passa pela revisão.
(request.resource.data.get('midias', []).size() == 0 || pp(request.auth.uid).get('menor', false) == false || request.resource.data.revisao == 'pendente') &&
// O cordão mostrado no post é o do cartão público (calculado no servidor).
(request.resource.data.get('autorCordao', '') == '' || request.resource.data.autorCordao == pp(request.auth.uid).get('cordaoAtual', '')) &&
(request.resource.data.get('tipo', 'post') != 'aviso' || ehPlataforma() || souFundador() ||
(ehGestor() && request.resource.data.nucleoId == minhaAcademiaGerenciada())) &&
// "Publicar como o núcleo": só o responsável, sempre no núcleo que administra.
(request.resource.data.get('comoNucleo', false) == false ||
(minhaAcademiaGerenciada() != null && request.resource.data.nucleoId == minhaAcademiaGerenciada() && (ehGestor() || ehPlataforma() || souFundador())));
// (aviso do Fundador: o post já nasce na escola dele — escolaNovaOk() acima.)
allow update: if logado() && (
// Autor: só edita texto, marcações e o selo de melhor momento.
(resource.data.autorUid == request.auth.uid &&
mudou().hasOnly(['texto', 'melhorMomento', 'hashtags', 'mencoes', 'marcados', 'visibilidade', 'editadoEm']) &&
request.resource.data.texto is string && request.resource.data.texto.size() <= 800 && listasDoPostOk()) ||
// Admin Master oculta/mostra qualquer post.
(ehAdmin() && mudou().hasOnly(['oculto', 'ocultadoPor', 'ocultadoEm', 'publico']) &&
publicoCoerente(request.resource.data.oculto, resource.data.get('revisao', 'ok'))) ||
// Curtir: só adiciona/remove o PRÓPRIO uid.
(mudou().hasOnly(['curtidas']) &&
// sem repetir o mesmo uid (cada curtida conta no brasão do autor)
request.resource.data.get('curtidas', []).toSet().size() == request.resource.data.get('curtidas', []).size() &&
request.resource.data.get('curtidas', []).removeAll(resource.data.get('curtidas', [])).hasOnly([request.auth.uid]) &&
resource.data.get('curtidas', []).removeAll(request.resource.data.get('curtidas', [])).hasOnly([request.auth.uid])) ||
(mudou().hasOnly(['comentariosCount']) &&
request.resource.data.comentariosCount - resource.data.get('comentariosCount', 0) in [-1, 1]) ||
// Revisão (foto de menor / sem termo de imagem): quem modera o post aprova.
(mudou().hasOnly(['revisao', 'revisadoPor', 'publico']) && moderaEstePost() &&
request.resource.data.revisao in ['ok', 'pendente'] &&
publicoCoerente(resource.data.get('oculto', false), request.resource.data.revisao))
);
// Apagar: só quem publicou (o Admin oculta, não apaga).
allow delete: if logado() && resource.data.autorUid == request.auth.uid;
match /comentarios/{cid} {
function post() { return get(/databases/$(database)/documents/posts/$(id)).data; }
function vejoOPost() {
return (post().get('publico', false) == true && post().get('escolaId', '') == minhaEscola()) || post().autorUid == request.auth.uid ||
ehPlataforma() || fundadorDa(post().get('escolaId', '')) ||
(ehGestor() && (post().get('autorAcademiaId', '') == minhaAcademiaGerenciada() || post().get('nucleoId', '') == minhaAcademiaGerenciada()));
}
allow read: if logado() && vejoOPost();
allow create: if logado() && idSeguro(cid) && vejoOPost() && request.resource.data.autorUid == request.auth.uid &&
request.resource.data.keys().hasOnly(['autorUid', 'autorNome', 'autorFoto', 'texto', 'criadoEm', 'respostaA', 'respostaANome', 'mencoes']) &&
request.resource.data.texto is string && request.resource.data.texto.size() <= 400 &&
request.resource.data.get('mencoes', []).size() <= 10;
allow delete: if logado() && (
resource.data.autorUid == request.auth.uid || ehPlataforma() || fundadorDa(post().get('escolaId', '')) ||
post().autorUid == request.auth.uid ||
(ehGestor() && post().get('autorAcademiaId', '') == minhaAcademiaGerenciada())
);
}
}

// stories: foto + legenda por 24h. "Como núcleo" só o responsável do núcleo,
// Admin ou Fundador.
match /stories/{id} {
allow read: if logado() && (daMinhaEscola() || ehPlataforma());
allow create: if logado() && idSeguro(id) && novoDaMinhaEscola() &&
request.resource.data.autorUid == request.auth.uid &&
request.resource.data.midiaUrl is string &&
request.resource.data.get('texto', '').size() <= 200 &&
request.resource.data.expiraEm is string && request.resource.data.criadoEm is string &&
request.resource.data.expiraEm > request.resource.data.criadoEm &&
(request.resource.data.get('comoNucleo', false) == false || ehPlataforma() || souFundador() ||
(ehGestor() && request.resource.data.nucleoId == minhaAcademiaGerenciada()));
allow delete: if logado() && (resource.data.autorUid == request.auth.uid || ehPlataforma() ||
(daMinhaEscola() && (souFundador() || (ehGestor() && resource.data.nucleoId == minhaAcademiaGerenciada()))));
}

// conversas: direta (2 participantes; id = uids ordenados) ou grupo do núcleo.
// Menores: a direta só existe dentro do MESMO núcleo (ou com o responsável
// desse núcleo). Quem ACOMPANHA a conversa de um menor é o responsável legal
// (pai/mãe cadastrado): o servidor grava os uids deles em responsaveisIds.
// O núcleo não lê conversa direta de ninguém — só modera o grupo do núcleo.
match /conversas/{id} {
function pp(u) { return get(/databases/$(database)/documents/perfisPublicos/$(u)).data; }
// Sem .get()/valor padrão aqui: nas consultas em lista o Firestore precisa
// PROVAR a regra a partir dos filtros (array-contains em participantes ou em
// responsaveisIds; tipo == 'grupo' + nucleoId).
function participo() { return request.auth.uid in resource.data.participantes; }
function membroDoGrupo() { return resource.data.tipo == 'grupo' && resource.data.nucleoId == meuPerfil().academiaId; }
function gestorDoGrupo() { return resource.data.tipo == 'grupo' && ehGestor() && resource.data.nucleoId == minhaAcademiaGerenciada(); }
function responsavelLegal() { return request.auth.uid in resource.data.responsaveisIds; }
function podeEscrever() { return logado() && (participo() || membroDoGrupo() || gestorDoGrupo()); }
// Fundador: só conversas da própria escola (o servidor grava escolaId ao criar a conversa).
function podeLer() { return podeEscrever() || (logado() && (ehPlataforma() || fundadorDa(resource.data.escolaId) || responsavelLegal())); }
function outroNaDireta() {
return request.resource.data.participantes[0] == request.auth.uid ? request.resource.data.participantes[1] : request.resource.data.participantes[0];
}
function diretaPermitida() {
return (pp(request.auth.uid).get('menor', false) == false && pp(outroNaDireta()).get('menor', false) == false) ||
pp(request.auth.uid).get('academiaId', '') == pp(outroNaDireta()).get('academiaId', '-') ||
(ehGestor() && pp(outroNaDireta()).get('academiaId', '') == minhaAcademiaGerenciada()) ||
pp(outroNaDireta()).get('academiaGerenciadaId', '') == pp(request.auth.uid).get('academiaId', '-') ||
ehPlataforma() || fundadorDa(pp(outroNaDireta()).get('escolaId', ''));
}
// Conferir se uma conversa AINDA NÃO existe (antes de criar) não revela nada.
allow get: if (logado() && resource == null) || podeLer();
allow list: if podeLer();
allow create: if logado() && idSeguro(id) && !request.resource.data.keys().hasAny(['responsaveisIds']) && escolaNovaOk() && (
(request.resource.data.tipo == 'direta' &&
request.resource.data.participantes.size() == 2 &&
request.auth.uid in request.resource.data.participantes &&
diretaPermitida()) ||
(request.resource.data.tipo == 'grupo' &&
(ehPlataforma() || fundadorDa(escolaDoNucleo(request.resource.data.nucleoId)) || (ehGestor() && request.resource.data.nucleoId == minhaAcademiaGerenciada())))
);
allow update: if podeEscrever() && escolaInalterada() &&
request.resource.data.tipo == resource.data.tipo &&
request.resource.data.get('nucleoId', '') == resource.data.get('nucleoId', '') &&
request.resource.data.get('responsaveisIds', null) == resource.data.get('responsaveisIds', null) &&
(request.resource.data.participantes == resource.data.participantes ||
 (resource.data.tipo == 'grupo' && (gestorDoGrupo() ||
  (request.resource.data.participantes.removeAll(resource.data.participantes).hasOnly([request.auth.uid]) &&
   resource.data.participantes.removeAll(request.resource.data.participantes).size() == 0))));
allow delete: if ehPlataforma() || fundadorDa(resource.data.get('escolaId', ''));
match /mensagens/{mid} {
function conversa() { return get(/databases/$(database)/documents/conversas/$(id)).data; }
function escreveNaConversa() {
return logado() && (
request.auth.uid in conversa().participantes ||
(conversa().tipo == 'grupo' && conversa().nucleoId == meuPerfil().academiaId) ||
(conversa().tipo == 'grupo' && ehGestor() && conversa().nucleoId == minhaAcademiaGerenciada())
);
}
function leConversa() {
return escreveNaConversa() || (logado() && (
request.auth.uid in conversa().get('responsaveisIds', []) || ehPlataforma() || fundadorDa(conversa().get('escolaId', ''))));
}
allow read: if leConversa();
allow create: if idSeguro(mid) && escreveNaConversa() && request.resource.data.autorUid == request.auth.uid &&
request.resource.data.get('texto', '').size() <= 1000;
allow delete: if logado() && (resource.data.autorUid == request.auth.uid || ehPlataforma() || fundadorDa(conversa().get('escolaId', '')) ||
(conversa().tipo == 'grupo' && ehGestor() && conversa().nucleoId == minhaAcademiaGerenciada()));
}
}

// Configuração dos brasões (ativos, textos, núcleo do Fundador): todo mundo
// logado lê, só Admin/Fundador gravam. A trava do Presidente do Grupo
// (config/brasoes.presidenteUid) só o Admin troca depois de gravada.
// config/migracoes é do servidor (marca as migrações já feitas).
match /config/{id} {
allow read: if logado();
allow write: if id != 'migracoes' && (admGeral() || (fundadorDaEscolaPadrao() && (
id != 'brasoes' || resource == null ||
resource.data.get('presidenteUid', null) == null ||
request.resource.data.get('presidenteUid', null) == resource.data.get('presidenteUid', null))));
}

// Denúncias de post ou comentário: qualquer logado denuncia; quem trata é
// Admin, Fundador ou o responsável do núcleo do autor do post.
match /denuncias/{id} {
allow create: if logado() && idSeguro(id) && request.resource.data.denuncianteUid == request.auth.uid &&
request.resource.data.get('motivo', '').size() <= 300 && escolaNovaOk() &&
request.resource.data.status == 'aberta';
allow read: if ehPlataforma() || fundadorDa(resource.data.escolaId) ||
(ehGestor() && resource.data.autorPostAcademiaId == minhaAcademiaGerenciada());
allow update: if ehPlataforma() || ((fundadorDa(resource.data.get('escolaId', '')) ||
(ehGestor() && resource.data.autorPostAcademiaId == minhaAcademiaGerenciada())) && escolaInalterada());
allow delete: if ehAdmin();
}

// ===== Carteirinha virtual do atleta =====
// carteirinhas/{codigo}: o mínimo para conferir o atleta pelo QR (v.html).
// Qualquer pessoa abre UMA pelo código; ninguém lista (não dá para varrer).
// Só o servidor grava. carteirinhasIndice e sistema: só o servidor (sem regra = fechado).
match /carteirinhas/{codigo} {
allow get: if true;
allow list, write: if false;
}

// fotosCarteirinha/{uid}: a foto de DOCUMENTO (separada da foto de perfil da Rede).
//   solicitada → o núcleo pediu a foto;  pendente → atleta/responsável enviou;
//   aprovada / recusada → o núcleo avaliou (o servidor monta a carteirinha).
match /fotosCarteirinha/{uid} {
function atleta() { return get(/databases/$(database)/documents/usuarios/$(uid)).data; }
function souDonoOuResponsavel() { return logado() && (request.auth.uid == uid || atleta().get('responsavelUid', null) == request.auth.uid); }
// Quem confere a foto é o NÚCLEO (responsável do núcleo, Admin ou Fundador).
function cuidoDoAtleta() {
return ehPlataforma() || fundadorDa(atleta().get('escolaId', '')) ||
(ehGestor() && atleta().get('academiaId', null) == minhaAcademiaGerenciada());
}
// escolaId: o servidor grava (mesma escola do atleta); o app pode mandar, mas só a certa.
function nucleoCerto() { return request.resource.data.academiaId == atleta().get('academiaId', null) &&
request.resource.data.get('escolaId', atleta().get('escolaId', '')) == atleta().get('escolaId', ''); }
function fotoValida() {
return request.resource.data.keys().hasOnly(['url', 'caminho', 'status', 'academiaId', 'alunoNome', 'enviadoPorUid', 'enviadoPorNome', 'enviadoEm',
'motivo', 'avaliadoPorUid', 'avaliadoPorNome', 'avaliadoEm', 'escolaId']) &&
request.resource.data.caminho is string && request.resource.data.caminho.matches('carteirinha/' + uid + '/[A-Za-z0-9_.-]+') &&
request.resource.data.url is string && request.resource.data.url.size() < 1500 &&
// o link tem que ser do MESMO arquivo de "caminho" (o núcleo aprova o que vê)
request.resource.data.url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/(capoeira-liberdade[.]firebasestorage[.]app|capoeira-liberdade[.]appspot[.]com)/o/carteirinha%2F' + uid + '%2F' + request.resource.data.caminho.split('/')[2] + '[?].*') &&
request.resource.data.enviadoPorUid == request.auth.uid && nucleoCerto() &&
request.resource.data.get('alunoNome', '').size() <= 120;
}
allow get: if souDonoOuResponsavel() || cuidoDoAtleta();
allow list: if ehPlataforma() || fundadorDa(resource.data.escolaId) || (ehGestor() && resource.data.academiaId == minhaAcademiaGerenciada());
allow create, update: if
// atleta ou responsável legal envia: sempre "pendente"
(souDonoOuResponsavel() && fotoValida() && request.resource.data.status == 'pendente') ||
// núcleo envia a foto pelo atleta (pode já aprovar)
(cuidoDoAtleta() && fotoValida() && request.resource.data.status in ['pendente', 'aprovada'] &&
(request.resource.data.status == 'pendente' || request.resource.data.get('avaliadoPorUid', '') == request.auth.uid)) ||
// núcleo avalia a foto enviada
(cuidoDoAtleta() && resource != null && resource.data.status == 'pendente' &&
mudou().hasOnly(['status', 'motivo', 'avaliadoPorUid', 'avaliadoPorNome', 'avaliadoEm']) &&
request.resource.data.status in ['aprovada', 'recusada'] && request.resource.data.avaliadoPorUid == request.auth.uid &&
request.resource.data.get('motivo', '').size() <= 200) ||
// núcleo pede a foto (notificação para o atleta e o responsável)
(cuidoDoAtleta() && request.resource.data.status == 'solicitada' && nucleoCerto() &&
request.resource.data.keys().hasOnly(['status', 'academiaId', 'alunoNome', 'solicitadoPorUid', 'solicitadoPorNome', 'solicitadoEm', 'escolaId']) &&
request.resource.data.solicitadoPorUid == request.auth.uid &&
(resource == null || resource.data.status != 'pendente'));
allow delete: if ehAdmin();
}

// beneficiarios/{uid}: pai, mãe, irmãos e avós do atleta (benefícios dos
// parceiros). Grava o próprio atleta, o responsável legal dele ou o núcleo.
// O servidor filtra o grau de parentesco e gera o código de cada um.
match /beneficiarios/{uid} {
function atletaB() { return get(/databases/$(database)/documents/usuarios/$(uid)).data; }
function cuidaDosBeneficiarios() {
return logado() && (request.auth.uid == uid || atletaB().get('responsavelUid', null) == request.auth.uid ||
ehPlataforma() || fundadorDa(atletaB().get('escolaId', '')) || (ehGestor() && atletaB().get('academiaId', null) == minhaAcademiaGerenciada()));
}
allow read, delete: if cuidaDosBeneficiarios();
allow create, update: if cuidaDosBeneficiarios() &&
request.resource.data.keys().hasOnly(['lista', 'atualizadoEm', 'porUid']) &&
request.resource.data.lista is list && request.resource.data.lista.size() <= 10 &&
request.resource.data.porUid == request.auth.uid;
}

// ===== Certificado de graduação (emitido só pelo servidor na troca de cordão) =====
// certificados/{codigo}: abre UM pelo código (certificado.html#CODIGO, o QR); ninguém lista.
match /certificados/{codigo} {
allow get: if true;
allow list, write: if false;
}
// assinaturas/{uid}: assinatura real (imagem) de quem assina certificados —
// o Fundador e os responsáveis de núcleo. Qualquer pessoa lê UMA (a página do
// certificado é pública); grava a própria pessoa (se assina) ou o Admin Master.
match /assinaturas/{uid} {
allow get: if true;
allow list: if ehPlataforma();
allow create, update: if logado() && (ehPlataforma() || adminDa(escolaDoUsuario(uid)) || (request.auth.uid == uid && (souFundador() || (ehGestor() && minhaAcademiaGerenciada() != null)))) &&
request.resource.data.keys().hasOnly(['url', 'nome', 'atualizadoEm', 'porUid']) &&
request.resource.data.porUid == request.auth.uid &&
request.resource.data.url is string && request.resource.data.url.size() < 1500 &&
request.resource.data.url.matches('https://firebasestorage[.]googleapis[.]com/v0/b/(capoeira-liberdade[.]firebasestorage[.]app|capoeira-liberdade[.]appspot[.]com)/o/assinaturas%2F' + uid + '%2F.*');
allow delete: if logado() && (ehPlataforma() || adminDa(escolaDoUsuario(uid)) || request.auth.uid == uid);
}
// certificadosDe/{uid}: a lista da pessoa (app) — ela, o responsável legal e o núcleo.
match /certificadosDe/{uid} {
function atletaC() { return get(/databases/$(database)/documents/usuarios/$(uid)).data; }
allow read: if logado() && (request.auth.uid == uid || atletaC().get('responsavelUid', null) == request.auth.uid ||
ehPlataforma() || fundadorDa(atletaC().get('escolaId', '')) || (ehGestor() && minhaAcademiaGerenciada() != null && atletaC().get('academiaId', null) == minhaAcademiaGerenciada()));
allow write: if false;
}

// ===== E-mails da própria plataforma (functions/src/emails.js) =====
// pedidosEmail: QUALQUER pessoa (até sem login, na tela "esqueci minha senha") pede
// o link — só com estes campos e tamanhos; ninguém lê, edita nem apaga (o servidor
// atende e apaga). Pedido de confirmação de e-mail: só do PRÓPRIO e-mail logado.
// Limites por e-mail e geral ficam no servidor (limitesEmail, sem regra = fechado).
match /pedidosEmail/{id} {
allow create: if request.resource.data.keys().hasOnly(['tipo', 'email', 'voltarPara', 'criadoEm', 'origem']) &&
request.resource.data.email is string && request.resource.data.email.size() <= 160 &&
request.resource.data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$') &&
request.resource.data.get('voltarPara', '') is string && request.resource.data.get('voltarPara', '').size() <= 300 &&
request.resource.data.get('origem', '') is string && request.resource.data.get('origem', '').size() <= 40 &&
(request.resource.data.tipo == 'senha' ||
 (request.resource.data.tipo == 'confirmar' && logado() && request.auth.token.get('email', '') == request.resource.data.email));
allow read, update, delete: if false;
}
// segredos/email: chave do serviço de envio. O Admin Master grava pelo Mega painel;
// NINGUÉM lê pelo app (nem o Admin) — só o servidor.
match /segredos/{id} {
allow read: if false;
allow create, update: if ehPlataforma() && id == 'email' &&
request.resource.data.keys().hasOnly(['provedor', 'chave', 'remetente', 'nomeRemetente', 'atualizadoEm', 'porUid']) &&
request.resource.data.provedor in ['resend', 'brevo'] &&
request.resource.data.chave is string && request.resource.data.chave.size() >= 10 && request.resource.data.chave.size() <= 300 &&
request.resource.data.get('remetente', '') is string && request.resource.data.get('remetente', '').size() <= 120 &&
request.resource.data.get('nomeRemetente', '') is string && request.resource.data.get('nomeRemetente', '').size() <= 60 &&
request.resource.data.porUid == request.auth.uid;
allow delete: if ehPlataforma();
}
// plataforma/publico: o que o app precisa saber da plataforma (e-mails próprios ligados?).
// Qualquer um lê; só o servidor grava.
match /plataforma/{id} {
allow read: if true;
allow write: if false;
}

// Conteúdo do site público (index.html): todo mundo lê; só o Admin Master
// grava (gerenciar.html), e só nos documentos que o site usa
// (site = no ar, site-anterior = cópia para desfazer, landing = site antigo).
match /siteConteudo/{id} {
allow read: if id == 'site' || id == 'landing' || admGeral();
allow write: if admGeral() && id in ['site', 'site-anterior', 'landing'];
}

// Coleções do sistema antigo (antes do Firebase Authentication). Nenhuma
// tela usa mais; ficam guardadas só para o Admin consultar. Antes estavam
// abertas para qualquer pessoa na internet ler e gravar.
match /academias/{id} { allow read, write: if admGeral(); }
match /admins/{id} { allow read, write: if admGeral(); }
match /alunos/{id} { allow read, write: if admGeral(); }
match /site_agenda/{id} { allow read, write: if admGeral(); }
match /site_equipe/{id} { allow read, write: if admGeral(); }
match /site_locais/{id} { allow read, write: if admGeral(); }
match /site_loja/{id} { allow read, write: if admGeral(); }
}
}
